"home.guide.bgRemove.desc" = "Apple Neural Engineతో చిత్ర నేపథ్యాన్ని స్వయంచాలకంగా తొలగించండి.";
"home.guide.bgRemove.step2" = "పరికరంలోని AIతో నేపథ్యం వెంటనే తొలగుతుంది.";
"home.guide.bgRemove.step3" = "PNG లేదా WebP అవుట్‌పుట్ ఫార్మాట్ ఎంచుకుని సేవ్ చేయండి.";
"home.guide.bgRemove.tip" = "స్పష్టమైన విషయం ఉన్న ఫోటోల్లో ఉత్తమం. macOS 14 Sonoma లేదా కొత్తది కావాలి.";
"home.guide.ocr.desc" = "దృశ్య అక్షర గుర్తింపుతో ఏ చిత్రం నుండైనా టెక్స్ట్ తీసి కాపీ చేయండి.";
"home.guide.ocr.step2" = "టూల్ అన్ని టెక్స్ట్‌ను స్వయంచాలకంగా గుర్తించి తీస్తుంది.";
"home.guide.ocr.step3" = "గుర్తించిన టెక్స్ట్‌ను కాపీ చేయండి లేదా ఫైల్‌గా సేవ్ చేయండి.";
"home.guide.ocr.tip" = "ముద్రిత టెక్స్ట్, స్క్రీన్‌షాట్‌లు మరియు స్కాన్ పత్రాలతో పనిచేస్తుంది.";
"home.guide.qr.desc" = "URL, టెక్స్ట్ లేదా ఏ డేటాకైనా అనుకూల QR కోడ్‌లు రూపొందించండి.";
"home.guide.qr.step1" = "ఇన్‌పుట్ ఫీల్డ్‌లో URL లేదా టెక్స్ట్ టైప్ చేయండి లేదా అతికించండి.";
"home.guide.qr.step2" = "ముందు/నేపథ్య రంగులు మరియు మూల వ్యాసార్థం అనుకూలీకరించండి.";
"home.guide.qr.step3" = "ఎంచుకున్న రిజల్యూషన్‌లో QR కోడ్‌ను PNG లేదా SVGగా డౌన్‌లోడ్ చేయండి.";
"home.guide.qr.tip" = "అధిక రిజల్యూషన్ ఎగుమతులు ముద్రణలో బాగా కనిపిస్తాయి.";
"home.guide.stock.desc" = "Pexels నుండి ఉచిత ఉన్నత నాణ్యత స్టాక్ ఫోటోలను వెతికి డౌన్‌లోడ్ చేయండి.";
"home.guide.stock.step1" = "సెర్చ్ బార్‌లో పదం టైప్ చేయండి (ఉదా. ‘పర్వతం’, ‘ఆఫీసు’).";
"home.guide.stock.step2" = "ఫలితాలు చూసి కావాల్సిన ఫోటోలు ఎంచుకోండి.";
"home.guide.stock.step3" = "డౌన్‌లోడ్ నొక్కి ఎంచుకున్న ఫోటోలను అసలు లేదా తక్కువ నాణ్యతలో సేవ్ చేయండి.";
"home.guide.stock.tip" = "అన్ని ఫోటోలు Pexels లైసెన్స్ కింద ఉచితం.";
"home.guide.font.desc" = "Google Fontsను నేరుగా Macకి చూసి ఇన్‌స్టాల్ చేయండి.";
"home.guide.font.step1" = "పేరుతో ఫాంట్ వెతకండి లేదా కేటలాగ్ చూడండి.";
"home.guide.font.step2" = "ఫాంట్ ప్రివ్యూ చూసి కావాల్సిన శైలులు ఎంచుకోండి.";
"home.guide.font.step3" = "డౌన్‌లోడ్ నొక్కి ఫాంట్‌ను Macలో ఇన్‌స్టాల్ చేయండి.";
"home.guide.font.tip" = "డౌన్‌లోడ్ చేసిన ఫాంట్లు సిస్టమ్‌వ్యాప్తంగా ఇన్‌స్టాల్ అయి అన్ని యాప్‌లలో వెంటనే లభిస్తాయి.";

