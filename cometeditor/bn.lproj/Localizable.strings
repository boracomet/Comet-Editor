"home.guide.bgRemove.step2" = "অন-ডিভাইস AI ব্যবহার করে ব্যাকগ্রাউন্ডটি অবিলম্বে সরানো হয় ।";
"home.guide.bgRemove.step3" = "PNG বা WebP আউটপুট ফরম্যাট বেছে নিন এবং সেভ করুন ।";
"home.guide.bgRemove.tip" = "একটি স্পষ্ট বিষয় সহ ফটোতে সেরা কাজ করে । MacOS 14 Sonoma বা তার পরে প্রয়োজন ।";
"home.guide.ocr.desc" = "অপটিক্যাল ক্যারেক্টার রিকগনিশন ব্যবহার করে যে কোনও চিত্র থেকে পাঠ্য বের করুন এবং অনুলিপি করুন ।";
"home.guide.ocr.step2" = "টুলটি স্বয়ংক্রিয়ভাবে সমস্ত পাঠ্য সনাক্ত করে এবং বের করে ।";
"home.guide.ocr.step3" = "স্বীকৃত পাঠ্যটি অনুলিপি করুন বা এটি একটি ফাইল হিসাবে সংরক্ষণ করুন ।";
"home.guide.ocr.tip" = "প্রিন্ট করা টেক্সট, স্ক্রিনশট এবং স্ক্যান করা ডকুমেন্টের সাথে কাজ করে ।";
"home.guide.qr.desc" = "ইউআরএল, টেক্সট বা যেকোনো ডেটার জন্য কাস্টম QR কোড তৈরি করুন ।";
"home.guide.qr.step1" = "ইনপুট ফিল্ডে একটি URL বা কোনও পাঠ্য টাইপ করুন বা পেস্ট করুন ।";
"home.guide.qr.step2" = "অগ্রভাগ/পটভূমির রঙ এবং কোণার ব্যাসার্ধ কাস্টমাইজ করুন ।";
"home.guide.qr.step3" = "আপনার নির্বাচিত রেজোলিউশনে PNG বা SVG হিসাবে QR কোডটি ডাউনলোড করুন ।";
"home.guide.qr.tip" = "ফিজিক্যাল ম্যাটেরিয়ালে ছাপা হলে উচ্চ রেজোলিউশনের রফতানি আরও ভাল দেখায় ।";
"home.guide.stock.desc" = "Pexels থেকে বিনামূল্যে উচ্চ মানের স্টক ফটো অনুসন্ধান এবং ডাউনলোড করুন ।";
"home.guide.stock.step1" = "অনুসন্ধান বারে একটি কীওয়ার্ড (যেমন 'পর্বত', 'অফিস') টাইপ করুন ।";
"home.guide.stock.step2" = "ফলাফলগুলি ব্রাউজ করুন এবং আপনি যে ছবিগুলি চান তা নির্বাচন করুন ।";
"home.guide.stock.step3" = "মূল বা নিম্ন মানের নির্বাচিত ফটোগুলি সংরক্ষণ করতে ডাউনলোড ক্লিক করুন ।";
"home.guide.stock.tip" = "সমস্ত ছবি Pexels লাইসেন্সের অধীনে বিনামূল্যে ব্যবহার করা যায় ।";
"home.guide.font.desc" = "সরাসরি আপনার ম্যাকে Google ফন্ট ব্রাউজ করুন এবং ইনস্টল করুন ।";
"home.guide.font.step1" = "নাম অনুসারে একটি ফন্ট অনুসন্ধান করুন বা ক্যাটালগ ব্রাউজ করুন ।";
"home.guide.font.step2" = "ফন্টের পূর্বরূপ দেখুন এবং আপনি যে স্টাইলগুলি চান তা নির্বাচন করুন ।";
"home.guide.font.step3" = "আপনার ম্যাকের ফন্ট ইনস্টল করতে ডাউনলোড ক্লিক করুন ।";
"home.guide.font.tip" = "ডাউনলোড করা ফন্টগুলি সিস্টেম-ব্যাপী ইনস্টল করা হয় এবং অবিলম্বে সমস্ত অ্যাপে পাওয়া যায় ।";

