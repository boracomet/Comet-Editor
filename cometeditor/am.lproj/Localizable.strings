"home.guide.stock.step2" = "ውጤቶችን ይአስሱ እና የሚፈልጉከውን ፍቶግራፎች ይምረጡ።";
"home.guide.stock.step3" = "የተመረጡትን ፍቶግራፎች በዘመር ወይም ደቅተኛ ጣራት ለማስቀመጥ አውርድን ይጥኑ።";
