"home.guide.font.desc" = "Google Fontsን በቀጥታ ወደ Mac ይፈልጉ እና ይጨምሩ።";
"home.guide.font.step1" = "ቅርጸ-ቁምፊ በስም ይፈልጉ ወይም ካታሎጉን ይአስሱ።";
"home.guide.font.step2" = "ቅርጸ-ቁምፊውን ቅድመ እይታ ይምልኩ እና የሚፈልጉከውን ቅርጸቶች ይምረጡ።";
