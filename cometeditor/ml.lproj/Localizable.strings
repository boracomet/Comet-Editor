"home.guide.upscale.step2" = "വലത് പാളിയിൽ സ്കെയിലും ഔട്ട്പുട്ട് ഫോർമാറ്റും (PNG, JPEG, WebP…) തിരഞ്ഞെടുക്കുക.";
"home.guide.upscale.step3" = "സ്ലൈഡറിൽ മുമ്പ്/ശേഷം താരതമ്യം ചെയ്യാൻ പ്രിവ്യൂ അമർത്തുക.";
"home.guide.upscale.step4" = "ലക്ഷ്യ ഫോൾഡർ തിരഞ്ഞെടുത്ത് എല്ലാ ചിത്രങ്ങളും സംരക്ഷിക്കാൻ വലുതാക്കുക അമർത്തുക.";
"home.guide.upscale.tip" = "8× ഉം 16× ഉം ഒന്നിലധികം AI പാസുകൾ ഓടിക്കുകയും കൂടുതൽ സമയമെടുക്കുകയും ചെയ്യും. റാസ്റ്റർ ഫോർമാറ്റുകൾ മാത്രം.";
"home.guide.video.desc" = "വീഡിയോകൾ MP4, MOV, AVI എന്നിവയിലേക്ക് പരിവർത്തനം ചെയ്ത് കംപ്രസ് ചെയ്യുക.";
"home.guide.video.step2" = "ഔട്ട്പുട്ട് ഫോർമാറ്റ് (MP4, MOV…) തിരഞ്ഞെടുത്ത് FPS അല്ലെങ്കിൽ റെസല്യൂഷൻ ക്രമീകരിക്കുക.";
"home.guide.video.step3" = "ഓഡിയോ ഓൺ അല്ലെങ്കിൽ ഓഫ് ചെയ്ത് പരിവർത്തനം ക്ലിക്ക് ചെയ്യുക.";
"home.guide.video.tip" = "ഏറ്റവും ചെറിയ ഫയലിന് 50% റെസല്യൂഷനും 30 FPS ഉം തിരഞ്ഞെടുക്കുക — സോഷ്യൽ മീഡിയയ്ക്ക് നല്ലത്.";
"home.guide.pdf.desc" = "PDF ഫയലുകൾ തിരുത്തുക, ക്രമീകരിക്കുക, കംപ്രസ് ചെയ്യുക, നിയന്ത്രിക്കുക.";
"home.guide.pdf.step1" = "PDF ഫയൽ എഡിറ്ററിലേക്ക് വലിച്ചിടുക.";
"home.guide.pdf.step2" = "ക്രമീകരണ മോഡിലേക്ക് മാറി പേജുകൾ വലിക്കുക അല്ലെങ്കിൽ ഇല്ലാതാക്കുക.";
"home.guide.pdf.step3" = "ഫയൽ കംപ്രസ് ചെയ്യാൻ PDF ഒപ്റ്റിമൈസ് ഉപയോഗിച്ച് ഗുണനിലവാര നില തിരഞ്ഞെടുക്കുക.";
"home.guide.pdf.step4" = "മാറ്റങ്ങൾ എക്സ്പോർട്ട് ചെയ്യാൻ PDF സംരക്ഷിക്കുക ക്ലിക്ക് ചെയ്യുക.";
"home.guide.pdf.tip" = "പേജ് ഇല്ലാതാക്കൽ അല്ലെങ്കിൽ ക്രമം മാറ്റം പഴയപടിയാക്കാൻ Ctrl+Z ഉപയോഗിക്കുക.";
"home.guide.bgRemove.desc" = "Apple Neural Engine ഉപയോഗിച്ച് ചിത്ര പശ്ചാത്തലം സ്വയം നീക്കുക.";
"home.guide.bgRemove.step2" = "ഉപകരണത്തിലെ AI ഉപയോഗിച്ച് പശ്ചാത്തലം ഉടൻ നീക്കപ്പെടും.";
"home.guide.bgRemove.step3" = "PNG അല്ലെങ്കിൽ WebP ഔട്ട്പുട്ട് ഫോർമാറ്റ് തിരഞ്ഞെടുത്ത് സംരക്ഷിക്കുക.";
"home.guide.bgRemove.tip" = "വ്യക്തമായ വിഷയമുള്ള ഫോട്ടോകളിൽ മികച്ചത്. macOS 14 Sonoma അല്ലെങ്കിൽ പുതിയത് വേണം.";
"home.guide.ocr.desc" = "ഒപ്റ്റിക്കൽ ക്യാരക്ടർ റെക്കഗ്നിഷൻ ഉപയോഗിച്ച് ഏത് ചിത്രത്തിൽ നിന്നും ടെക്സ്റ്റ് എടുത്ത് പകർത്തുക.";
"home.guide.ocr.step2" = "ഉപകരണം എല്ലാ ടെക്സ്റ്റും സ്വയം കണ്ടെത്തി എടുക്കുന്നു.";
"home.guide.ocr.step3" = "തിരിച്ചറിഞ്ഞ ടെക്സ്റ്റ് പകർത്തുക അല്ലെങ്കിൽ ഫയലായി സംരക്ഷിക്കുക.";
"home.guide.ocr.tip" = "അച്ചടിച്ച ടെക്സ്റ്റ്, സ്ക്രീൻഷോട്ടുകൾ, സ്കാൻ രേഖകൾ എന്നിവയുമായി പ്രവർത്തിക്കുന്നു.";
"home.guide.qr.desc" = "URL, ടെക്സ്റ്റ് അല്ലെങ്കിൽ ഏത് ഡേറ്റയ്ക്കും ഇഷ്ടാനുസൃത QR കോഡുകൾ സൃഷ്ടിക്കുക.";
"home.guide.qr.step1" = "ഇൻപുട്ട് ഫീൽഡിൽ URL അല്ലെങ്കിൽ ടെക്സ്റ്റ് ടൈപ്പ് ചെയ്യുക അല്ലെങ്കിൽ ഒട്ടിക്കുക.";
"home.guide.qr.step2" = "മുൻഭാഗ/പശ്ചാത്തല നിറങ്ങളും മൂല ആരവും ഇഷ്ടാനുസൃതമാക്കുക.";
"home.guide.qr.step3" = "തിരഞ്ഞെടുത്ത റെസല്യൂഷനിൽ QR കോഡ് PNG അല്ലെങ്കിൽ SVG ആയി ഡൗൺലോഡ് ചെയ്യുക.";
"home.guide.qr.tip" = "ഉയർന്ന റെസല്യൂഷൻ എക്സ്പോർട്ടുകൾ അച്ചടിയിൽ മികച്ചതായി കാണാം.";
"home.guide.stock.desc" = "Pexels-ൽ നിന്ന് സൗജന്യ ഉയർന്ന നിലവാരമുള്ള സ്റ്റോക്ക് ഫോട്ടോകൾ തിരഞ്ഞ് ഡൗൺലോഡ് ചെയ്യുക.";
"home.guide.stock.step1" = "സെർച്ച് ബാറിൽ ഒരു വാക്ക് ടൈപ്പ് ചെയ്യുക (ഉദാ. ‘മല’, ‘ഓഫീസ്’).";
"home.guide.stock.step2" = "ഫലങ്ങൾ ബ്രൗസ് ചെയ്ത് വേണ്ട ഫോട്ടോകൾ തിരഞ്ഞെടുക്കുക.";
"home.guide.stock.step3" = "ഡൗൺലോഡ് ക്ലിക്ക് ചെയ്ത് തിരഞ്ഞെടുത്ത ഫോട്ടോകൾ യഥാർത്ഥമോ കുറഞ്ഞ നിലവാരത്തിലോ സംരക്ഷിക്കുക.";
"home.guide.stock.tip" = "എല്ലാ ഫോട്ടോകളും Pexels ലൈസൻസിന് കീഴിൽ സൗജന്യമാണ്.";
"home.guide.font.desc" = "Google Fonts നേരിട്ട് Mac-ലേക്ക് ബ്രൗസ് ചെയ്ത് ഇൻസ്റ്റാൾ ചെയ്യുക.";
"home.guide.font.step1" = "പേരിൽ ഫോണ്ട് തിരയുക അല്ലെങ്കിൽ കാറ്റലോഗ് ബ്രൗസ് ചെയ്യുക.";
"home.guide.font.step2" = "ഫോണ്ട് പ്രിവ്യൂ ചെയ്ത് വേണ്ട ശൈലികൾ തിരഞ്ഞെടുക്കുക.";
"home.guide.font.step3" = "ഡൗൺലോഡ് ക്ലിക്ക് ചെയ്ത് ഫോണ്ട് Mac-ൽ ഇൻസ്റ്റാൾ ചെയ്യുക.";
"home.guide.font.tip" = "ഡൗൺലോഡ് ചെയ്ത ഫോണ്ടുകൾ സിസ്റ്റം മുഴുവൻ ഇൻസ്റ്റാൾ ചെയ്ത് എല്ലാ ആപ്പുകളിലും ഉടൻ ലഭ്യമാകും.";

