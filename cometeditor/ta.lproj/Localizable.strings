"home.guide.step.drop" = "கோப்புகளைக் கருவியில் இழுத்து விடவும், அல்லது தேர்ந்தெடுக்க கிளிக் செய்யவும்.";
"home.guide.step.convert" = "மாற்று பொத்தானை அழுத்தி முடிவைக் காத்திருக்கவும்.";
"home.guide.convertImage.desc" = "தரம் மற்றும் அளவு விருப்பங்களுடன் 15+ வடிவங்களுக்கு இடையே மாற்றவும்.";
"home.guide.convertImage.step2" = "வலது பலகத்திலிருந்து வெளியீட்டு வடிவத்தை (PNG, JPG, WebP, HEIC போன்றவை) தேர்ந்தெடுக்கவும்.";
"home.guide.convertImage.step3" = "தரம், அளவுகோல் அல்லது பரிமாணத்தை சரிசெய்து மாற்றவும்.";
"home.guide.convertImage.tip" = "ஒரே நேரத்தில் பல படங்களைச் சேர்க்கலாம். ஒவ்வொரு கோப்பும் அதே அமைப்புகளுடன் மாற்றப்படும்.";
"home.guide.upscale.desc" = "சாதனத்தில் உள்ள AI பெரிதாக்கியால் புகைப்படங்களைக் கூர்மைப்படுத்தி பெரிதாக்கவும் (2×–16×).";
"home.guide.upscale.step2" = "வலது பலகத்தில் அளவுகோல் மற்றும் வெளியீட்டு வடிவத்தை (PNG, JPEG, WebP…) தேர்ந்தெடுக்கவும்.";
"home.guide.upscale.step3" = "ஸ்லைடரால் முன்/பின் ஒப்பிட விரும்பினால் முன்னோட்டம் தட்டவும்.";
"home.guide.upscale.step4" = "இலக்கு கோப்புறையைத் தேர்ந்து, அனைத்துப் படங்களையும் சேமிக்க பெரிதாக்கு தட்டவும்.";
"home.guide.upscale.tip" = "8× மற்றும் 16× பல AI பாஸ்கள் இயக்கி அதிக நேரம் எடுக்கும். ராஸ்டர் வடிவங்கள் மட்டும்.";
"home.guide.video.desc" = "வீடியோக்களை MP4, MOV, AVI மற்றும் பிறவற்றுக்கு மாற்றிச் சுருக்கவும்.";
"home.guide.video.step2" = "வெளியீட்டு வடிவத்தை (MP4, MOV…) தேர்ந்து FPS அல்லது தெளிவைச் சரிசெய்யவும்.";
"home.guide.video.step3" = "ஒலியை இயக்கவும் அல்லது முடக்கவும், பின் மாற்று கிளிக் செய்யவும்.";
"home.guide.video.tip" = "சிறிய கோப்புக்கு 50% தெளிவு மற்றும் 30 FPS தேர்ந்தெடுக்கவும் — சமூக ஊடகத்துக்கு ஏற்றது.";
"home.guide.pdf.desc" = "PDF கோப்புகளைத் திருத்த, வரிசைப்படுத்த, சுருக்க மற்றும் நிர்வகிக்கவும்.";
"home.guide.pdf.step1" = "PDF கோப்பைத் திருத்தியில் இழுத்து விடவும்.";
"home.guide.pdf.step2" = "வரிசை பயன்முறைக்கு மாறி பக்கங்களை இழுக்கவும் அல்லது நீக்கவும்.";
"home.guide.pdf.step3" = "கோப்பைச் சுருக்க PDF மேம்படுத்து பயன்படுத்தி தர நிலையைத் தேர்ந்தெடுக்கவும்.";
"home.guide.pdf.step4" = "மாற்றங்களை ஏற்றுமதி செய்ய PDF சேமி கிளிக் செய்யவும்.";
"home.guide.pdf.tip" = "பக்க நீக்கம் அல்லது வரிசை மாற்றத்தை செயல்தவிர்க்க Ctrl+Z பயன்படுத்தவும்.";
"home.guide.bgRemove.desc" = "Apple Neural Engine மூலம் படப் பின்னணியைத் தானாக நீக்கவும்.";
"home.guide.bgRemove.step2" = "சாதனத்தில் உள்ள AI மூலம் பின்னணி உடனடியாக நீக்கப்படும்.";
"home.guide.bgRemove.step3" = "PNG அல்லது WebP வெளியீட்டு வடிவத்தைத் தேர்ந்து சேமிக்கவும்.";
"home.guide.bgRemove.tip" = "தெளிவான பொருள் உள்ள புகைப்படங்களில் சிறந்தது. macOS 14 Sonoma அல்லது புதியது தேவை.";
"home.guide.ocr.desc" = "ஒளியியல் எழுத்து அடையாளம் மூலம் எந்தப் படத்திலிருந்தும் உரை எடுத்து நகலெடுக்கவும்.";
"home.guide.ocr.step2" = "கருவி அனைத்து உரையையும் தானாகக் கண்டறிந்து எடுக்கும்.";
"home.guide.ocr.step3" = "அடையாளம் காணப்பட்ட உரையை நகலெடுக்கவும் அல்லது கோப்பாகச் சேமிக்கவும்.";
"home.guide.ocr.tip" = "அச்சிட்ட உரை, திரைப்பிடிப்புகள் மற்றும் ஸ்கேன் ஆவணங்களுடன் வேலை செய்யும்.";
"home.guide.qr.desc" = "URL, உரை அல்லது எந்தத் தரவுக்கும் தனிப்பயன் QR குறியீடுகளை உருவாக்கவும்.";
"home.guide.qr.step1" = "உள்ளீட்டுப் புலத்தில் URL அல்லது உரையைத் தட்டச்சு செய்யவும் அல்லது ஒட்டவும்.";
"home.guide.qr.step2" = "முன்புற/பின்னணி நிறங்கள் மற்றும் மூலை ஆரத்தைத் தனிப்பயனாக்கவும்.";
"home.guide.qr.step3" = "தேர்ந்த தெளிவில் QR குறியீட்டை PNG அல்லது SVG ஆகப் பதிவிறக்கவும்.";
"home.guide.qr.tip" = "உயர் தெளிவு ஏற்றுமதி அச்சிடும்போது சிறப்பாகத் தெரியும்.";
"home.guide.stock.desc" = "Pexels-இலிருந்து இலவச உயர்தர ஸ்டாக் புகைப்படங்களைத் தேடிப் பதிவிறக்கவும்.";
"home.guide.stock.step1" = "தேடல் பட்டியில் சொல்லை (எ.கா. ‘மலை’, ‘அலுவலகம்’) தட்டச்சு செய்யவும்.";
"home.guide.stock.step2" = "முடிவுகளை உலாவி விரும்பும் புகைப்படங்களைத் தேர்ந்தெடுக்கவும்.";
"home.guide.stock.step3" = "பதிவிறக்கம் கிளிக் செய்து தேர்ந்த புகைப்படங்களை அசல் அல்லது குறைந்த தரத்தில் சேமிக்கவும்.";
"home.guide.stock.tip" = "அனைத்துப் புகைப்படங்களும் Pexels உரிமத்தின் கீழ் இலவசம்.";
"home.guide.font.desc" = "Google Fonts-ஐ நேரடியாக Mac-இல் உலாவி நிறுவவும்.";
"home.guide.font.step1" = "பெயரால் எழுத்துரு தேடவும் அல்லது பட்டியலை உலாவவும்.";
"home.guide.font.step2" = "எழுத்துருவை முன்னோட்டமிட்டு விரும்பும் பாணிகளைத் தேர்ந்தெடுக்கவும்.";
"home.guide.font.step3" = "பதிவிறக்கம் கிளிக் செய்து எழுத்துருவை Mac-இல் நிறுவவும்.";
"home.guide.font.tip" = "பதிவிறக்கப்பட்ட எழுத்துருக்கள் கணினி முழுவதும் நிறுவப்பட்டு அனைத்துச் செயலிகளிலும் உடனடியாகக் கிடைக்கும்.";

