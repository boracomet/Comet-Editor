prefix=/Users/boradev/Desktop/comet/cometeditor/third_party/install/arm64
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libavif
Description: Library for encoding and decoding .avif files
Version: 1.4.0
Libs: -L${libdir} -lavif
Libs.private: -lyuv
Cflags: -I${includedir}
Cflags.private: -UAVIF_DLL
Requires.private: aom
