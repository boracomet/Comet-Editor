# Build artifacts
build/
DerivedData/
*.o
*.so
*.dylib

# Ignore .a files globally except in third_party
*.a
!third_party/**/*.a

# Dependencies (FFmpeg sources and local builds)
third_party/ffmpeg_src/
third_party/ffmpeg_build/
third_party/build/
third_party/libwebp/
third_party/libvpx/
third_party/x264/

# FFmpeg per-arch build artifacts (only universal/ is committed)
third_party/ffmpeg/src/
third_party/ffmpeg/arm64/
third_party/ffmpeg/x86_64/

# ImageMagick per-arch build artifacts (only universal/ is committed)
third_party/imagemagick/src/
third_party/imagemagick/arm64/
third_party/imagemagick/x86_64/

# Keep compiled libraries for Xcode Cloud
# third_party/install/
# third_party/ffmpeg_install/

# Log files
*.log

# macOS specific
.DS_Store

# Ruby/Scripts temp files
/tmp/
